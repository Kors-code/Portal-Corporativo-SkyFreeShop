APP_NAME="Portal Sky Free Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local app, remote data through an SSH tunnel.
# The tunnel maps 127.0.0.1:3307 on your machine to MySQL 127.0.0.1:3306 on the VPS.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DB_SECOND_CONNECTION=mysql_personal
DB_SECOND_HOST=127.0.0.1
DB_SECOND_PORT=3307
DB_SECOND_DATABASE=
DB_SECOND_USERNAME=
DB_SECOND_PASSWORD=

DB_BUDGET_HOST=127.0.0.1
DB_BUDGET_PORT=3307
DB_BUDGET_DATABASE=
DB_BUDGET_USERNAME=
DB_BUDGET_PASSWORD=

# Keep local development runtime state out of the VPS database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="local@portal.test"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_TOKEN=
WHATSAPP_GROUP_ID=
WHATSAPP_AUTOMATION_TOKEN=
IMPORT_AUTOMATION_TOKEN=

# Optional SSH tunnel automation used by tools/dev-local.ps1 -WithTunnel.
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_PORT=22
VPS_DB_HOST=127.0.0.1
VPS_DB_PORT=3306
LOCAL_DB_PORT=3307
