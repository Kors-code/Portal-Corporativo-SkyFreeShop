APP_NAME="Portal Sky Free Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
AUTOMATION_RATE_LIMIT_PER_MINUTE=30

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local app, remote data through an SSH tunnel.
# The tunnel maps 127.0.0.1:3307 on your machine to MySQL 127.0.0.1:3306 on the VPS.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DB_SECOND_CONNECTION=mysql_personal
DB_SECOND_HOST=127.0.0.1
DB_SECOND_PORT=3307
DB_SECOND_DATABASE=
DB_SECOND_USERNAME=
DB_SECOND_PASSWORD=

DB_BUDGET_HOST=127.0.0.1
DB_BUDGET_PORT=3307
DB_BUDGET_DATABASE=
DB_BUDGET_USERNAME=
DB_BUDGET_PASSWORD=

# Keep local development runtime state out of the VPS database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=sfs_
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Keep false when pointing to VPS. Set true only after switching to a local DB clone.
SALES_ROLE_RECTIFICATION_ALLOW_APPLY=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="local@portal.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILERSEND_API_KEY=

WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=57
WHATSAPP_RECIPIENT_NUMBERS=
WHATSAPP_DAILY_REPORT_TEMPLATE=reporte_diario_sky
WHATSAPP_MENU_TEMPLATE=menu_reportes_sky
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_MENU_TEMPLATE_LANGUAGE=
WHATSAPP_MENU_TEMPLATE_LANGUAGE_FALLBACKS=es_ES,es,es_CO
WHATSAPP_DAILY_REPORT_TEMPLATE_BODY_PARAMS=2
WHATSAPP_DAILY_REPORT_TEMPLATE_BODY_PARAM_NAMES=nombre,fecha
WHATSAPP_MENU_TEMPLATE_BODY_PARAM_NAMES=nombre
WHATSAPP_AUTOMATION_TOKEN=
IMPORT_AUTOMATION_TOKEN=

# Optional SSH tunnel automation used by tools/dev-local.ps1 -WithTunnel.
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_DB_HOST=127.0.0.1
VPS_DB_PORT=3306
LOCAL_DB_PORT=3307
