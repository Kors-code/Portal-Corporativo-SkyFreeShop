APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
API_RATE_LIMIT_PER_MINUTE=60
AUTOMATION_RATE_LIMIT_PER_MINUTE=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL local example:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=skyfree
# DB_USERNAME=skyfree
# DB_PASSWORD=

# Extra app databases. Keep these connection names because the code uses
# DB::connection('budget') and DB::connection('mysql_personal').
# DB_BUDGET_CONNECTION=pgsql
# DB_BUDGET_HOST=127.0.0.1
# DB_BUDGET_PORT=5432
# DB_BUDGET_DATABASE=skyfree_budget
# DB_BUDGET_USERNAME=skyfree
# DB_BUDGET_PASSWORD=
# DB_BUDGET_SEARCH_PATH=public
# DB_SECOND_CONNECTION=pgsql
# DB_SECOND_HOST=127.0.0.1
# DB_SECOND_PORT=5432
# DB_SECOND_DATABASE=skyfree_personal
# DB_SECOND_USERNAME=skyfree
# DB_SECOND_PASSWORD=
# DB_SECOND_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=sfs_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILERSEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=57
WHATSAPP_RECIPIENT_NUMBERS=
WHATSAPP_DAILY_REPORT_TEMPLATE=reporte_diario_sky
WHATSAPP_MENU_TEMPLATE=menu_reportes_sky
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_MENU_TEMPLATE_LANGUAGE=
WHATSAPP_MENU_TEMPLATE_LANGUAGE_FALLBACKS=es_ES,es,es_CO
WHATSAPP_DAILY_REPORT_TEMPLATE_BODY_PARAMS=2
WHATSAPP_DAILY_REPORT_TEMPLATE_BODY_PARAM_NAMES=nombre,fecha
WHATSAPP_MENU_TEMPLATE_BODY_PARAM_NAMES=nombre
WHATSAPP_IMPORT_REPORT_COOLDOWN_MINUTES=50
WHATSAPP_AUTOMATION_TOKEN=

ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_INFO_USER_ID=
ONEDRIVE_INFO_FOLDER="Info Asesores"
# Optional. If empty, Passenger Intelligence reuses ONEDRIVE_INFO_USER_ID.
ONEDRIVE_PAX_USER_ID=
ONEDRIVE_PAX_FOLDER="Power Bussines Inteligence Sky Free Shop/Power BI Sky Free Shop DATA/POWER BI Commercial/PAX/PAX Col"
ONEDRIVE_CA_BUNDLE=

DATOS_GOV_VERIFY_SSL=false
