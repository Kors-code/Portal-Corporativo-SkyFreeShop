  "item": [
    {
      "name": "Login - completar variable contrasena",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "tenantId",
            "value": "{{tenantId}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"uuid\": \"9999-9999-99HG-SACC-UUID\",\n  \"tipo_sesion\": \"ESCRITORIO\",\n  \"direccion_mac\": \"FA:16:3E:49:A9:BF\",\n  \"reemplazar\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Ventas - primera pagina",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "tenantId",
            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": "{{url}}/api/v1/ventas/documentos?limit=100&offset=0"
      }
    },
    {
