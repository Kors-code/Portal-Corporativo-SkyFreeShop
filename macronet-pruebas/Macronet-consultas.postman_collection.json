{
  "info": {
    "name": "Macronet SKYFREE - consultas verificadas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "url",
      "value": "http://74.208.89.166:8080"
    },
    {
      "key": "tenantId",
      "value": "skyfree"
    },
    {
      "key": "usuario",
      "value": "SCLMDE"
