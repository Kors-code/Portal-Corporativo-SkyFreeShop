BACKEND_URL=http://127.0.0.1:8000
IMPORT_AUTOMATION_TOKEN=pon-el-mismo-token-de-laravel

# OAuth Gmail API. Crea credenciales tipo "Desktop app" en Google Cloud.
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_DOWNLOAD_DIR=./downloads
STATE_PATH=./state.json

# Corre una vez al iniciar y luego segun cron.
RUN_ON_START=true
CRON_SCHEDULE=*/30 * * * *
TIMEZONE=America/Bogota

# Catalogo de productos. Ajusta subject/from segun el correo real.
CATALOG_ENABLED=true
CATALOG_QUERY=from:proveedor@example.com subject:(catalogo) has:attachment newer_than:2d
CATALOG_ENDPOINT=/api/automation/import-catalog

# Inventarios por tienda. storeId debe ser el id de la tabla budget.stores.
# Puedes dejar [] mientras solo automatizas catalogo.
INVENTORY_RULES_JSON=[]
# Ejemplo:
# INVENTORY_RULES_JSON=[{"name":"COLS1","storeId":1,"query":"from:proveedor@example.com subject:(inventario COLS1) has:attachment newer_than:2d"},{"name":"COLS2","storeId":2,"query":"from:proveedor@example.com subject:(inventario COLS2) has:attachment newer_than:2d"}]
INVENTORY_ENDPOINT=/api/v1/inventory/import-automation

# Hojas de vida por vacante. vacanteSlug debe existir en la tabla vacantes.slug.
# El servicio descarga adjuntos .pdf, .doc y .docx y los envia al backend.
RESUME_RULES_JSON=[]
# Ejemplo:
# RESUME_RULES_JSON=[{"name":"ventas","vacanteSlug":"asesor-comercial","query":"subject:(hoja de vida OR cv) has:attachment newer_than:2d"}]
RESUMES_ENDPOINT=/api/automation/import-cvs

# Fallback con IA: si el asunto/remitente no alcanza para rutear por reglas,
# envia el CV al backend y Laravel escoge la vacante con IA.
RESUME_AUTO_ENABLED=false
RESUME_AUTO_QUERY=from:rrhh@example.com subject:(hoja de vida OR cv OR hv) has:attachment after:2026/09/16
RESUMES_AUTO_ENDPOINT=/api/automation/import-cvs/auto
GMAIL_MAX_RESULTS=25
